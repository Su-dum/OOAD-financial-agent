# ===== LLM 配置 =====
# provider 可选：deepseek（官方）/ openai（官方）/ custom（任意兼容端点）
LLM_PROVIDER=custom

# custom 时必须填这两项
# 例：学校内网网关（仅校园网可达）
#   LLM_BASE_URL=https://sustech-ooad.dns.navy:19443/v1
#   LLM_MODEL=deepseek-flash
LLM_BASE_URL=
LLM_MODEL=

# key 填在 .env 里（不要填在这里！本文件会被提交到 git）
LLM_API_KEY=

# 主模型失败时自动降级（flash 快；失败可退回更稳的 v4-pro）
# LLM_FALLBACK_MODEL=deepseek-v4-pro

# 推理模型（v4-pro / r1 等）的思考过程也计入 completion_tokens，
# 给小了会出现 finish_reason=length 且 content 为空。默认 2500 足够。
# LLM_MAX_TOKENS=2500
# LLM_TIMEOUT=90
# LLM_TEMPERATURE=0

# ===== 行情缓存有效期（秒）=====
# MARKET_CACHE_TTL=43200

# ===== 定时巡检（B1：让监控从「按需刷新」变成自动巡检）=====
# 盘中轻量档：只检测行情 + 行业事件（不碰新闻/公告，行情走缓存，实测 0.1~1.8s）
# 盘后完整档：补当天新闻与公告 → 检测 → 自动调查 → 裁剪（实测约 19s）
# 实际外部请求约 40 次/天，比人工反复点「更新数据」还少。
MONITOR_ENABLED=true
# 盘中轻量档间隔（分钟）。最小值强制 5，避免把数据源打穿
MONITOR_INTERVAL_MINUTES=30
# 轻量窗口（含起不含止）。A 股 9:30–11:30 / 13:00–15:00，这里放宽到 9:00–15:00
MONITOR_LIGHT_START=09:00
MONITOR_LIGHT_END=15:00
# 完整档固定时点（逗号分隔，本地时间）。默认收盘后 + 晚间各一次
MONITOR_FULL_SLOTS=16:00,21:00
# 时点后多少分钟内仍补跑（线程卡顿容忍）
MONITOR_FULL_GRACE_MINUTES=10
# 事件回看天数（z-score 需要 61 个历史点，别低于 90）
MONITOR_DETECT_DAYS=180
MONITOR_SKIP_WEEKENDS=true
# 后台线程多久检查一次排班（秒）
MONITOR_TICK_SECONDS=30

# ===== 自动调查（B3）=====
# llm（默认）：刷新时自动调查也走大模型；网关抖动会**自动降级**到模板并记录原因
# template   ：强制走模板拼接（离线演示 / 极度在意刷新时长时用）
# AUTO_INVESTIGATE_MODE=llm
# 单次刷新最多自动调查几条
# AUTO_INVESTIGATE_MAX=2
# 自动调查的最低事件等级（low / medium / high）
# AUTO_INVESTIGATE_MIN_SEVERITY=high

# ===== 重大事件提醒（右上角弹窗）=====
# 只提醒这个等级及以上的事件（默认 high，避免打扰）
# ALERT_MIN_SEVERITY=high
