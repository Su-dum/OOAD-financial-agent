# ===== LLM 配置 =====
# provider 可选：deepseek（官方）/ openai（官方）/ custom（任意兼容端点）
LLM_PROVIDER=custom

# custom 时必须填这两项
# 例：学校内网网关（仅校园网可达）
#   LLM_BASE_URL=https://sustech-ooad.dns.navy:19443/v1
#   LLM_MODEL=deepseek-flash
LLM_BASE_URL=
LLM_MODEL=

# key 填在 .env 里（不要填在这里！本文件会被提交到 git）
LLM_API_KEY=

# 主模型失败时自动降级（flash 快；失败可退回更稳的 v4-pro）
# LLM_FALLBACK_MODEL=deepseek-v4-pro

# 推理模型（v4-pro / r1 等）的思考过程也计入 completion_tokens，
# 给小了会出现 finish_reason=length 且 content 为空。默认 2500 足够。
# LLM_MAX_TOKENS=2500
# LLM_TIMEOUT=90
# LLM_TEMPERATURE=0

# ===== 行情缓存有效期（秒）=====
# MARKET_CACHE_TTL=43200
